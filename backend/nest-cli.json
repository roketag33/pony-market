{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "tsconfig.json",
    "assets": ["**/*.proto"],
    "watchAssets": true
  },
  "watchOptions": {
    "watchFile": "priorityPolling",
    "watchDirectory": "priorityPolling",
    "usePolling": true,
    "interval": 500,
    "followSymlinks": true,
    "ignored": ["node_modules", "dist"]
  }
}