generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums pour les utilisateurs et rôles
enum Role {
  USER
  ADMIN
  EDITOR
}

enum Status {
  ACTIVE
  SUSPENDED
  PENDING
  DELETED
}

// Enums pour les produits
enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum ProductCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ProductSize {
  XXS
  XS
  S
  M
  L
  XL
  XXL
  OTHER
}

// Enums pour les litiges
enum DisputeStatus {
  OPENED
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum DisputeReason {
  ITEM_NOT_RECEIVED
  ITEM_NOT_AS_DESCRIBED
  DAMAGED_ITEM
  WRONG_ITEM
  OTHER
}

// Enums pour les paiements
enum PaymentProvider {
  STRIPE
  PAYPAL
  APPLE_PAY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Nouveaux enums pour les transactions
enum TransactionType {
  PAYMENT
  REFUND
  COMMISSION
  WITHDRAWAL
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Modèle User principal
model User {
  id                     Int       @id @default(autoincrement())
  email                  String    @unique
  password               String
  firstName              String?
  lastName               String?
  role                   Role      @default(USER)
  refreshToken           String?   @unique
  refreshTokenExpiry     DateTime?
  emailVerified          Boolean   @default(false)
  emailVerificationToken String?
  resetToken             String?   @unique
  resetTokenExpiry       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  status                 Status    @default(ACTIVE)
  avatarUrl              String?
  bio                    String?
  dateOfBirth            DateTime?
  phoneNumber            String?   @unique
  referralCode           String?   @unique

  // Nouveaux champs pour Stripe
  stripeCustomerId    String? @unique
  stripeAccountId     String? @unique
  stripeAccountStatus String? @default("PENDING")

  // Relations avec Address
  addresses        Address[]
  defaultAddress   Address?  @relation("DefaultAddress", fields: [defaultAddressId], references: [id])
  defaultAddressId Int?      @unique

  // Relations produits et articles
  products Product[]
  articles Post[]

  // Relations commandes et transactions
  buyerOrders          Order[]       @relation("BuyerOrders")
  sellerOrders         Order[]       @relation("SellerOrders")
  transactionsAsSeller Transaction[] @relation("SellerTransactions")
  transactionsAsBuyer  Transaction[] @relation("BuyerTransactions")

  // Avis et favoris
  reviews   Review[]
  wishlist  Wishlist[]
  feedbacks UserFeedback[]

  // Abonnements et favoris
  categorySubscriptions   CategorySubscription[]
  favoriteSellersAsUser   FavoriteSeller[]       @relation("UserFavorites")
  favoriteSellersAsSeller FavoriteSeller[]       @relation("SellerFavorites")

  // Messagerie
  sentMessages     Message[] @relation("messageSender")
  receivedMessages Message[] @relation("messageReceiver")

  // Préférences et logs
  communicationPreference CommunicationPreference?
  emailLogs               EmailLog[]

  // Litiges
  disputesAsBuyer  Dispute[] @relation("BuyerDisputes")
  disputesAsSeller Dispute[] @relation("SellerDisputes")

  // Parrainage
  referrals        Referral[] @relation("UserReferrals")
  referredBy       Referral[] @relation("ReferredUsers")
  Refund           Refund[]
  refundsRequested Refund[]   @relation("RefundRequester")
  refundsApproved  Refund[]   @relation("RefundApprover")
}

// Modèle Order
model Order {
  id                Int         @id @default(autoincrement())
  buyerId           Int
  sellerId          Int
  totalPrice        Float
  status            OrderStatus @default(PENDING)
  shippingCost      Float       @default(0)
  shippingAddressId Int?
  billingAddressId  Int?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  products        Product[]     @relation("OrderProducts")
  buyer           User          @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller          User          @relation("SellerOrders", fields: [sellerId], references: [id])
  transactions    Transaction[]
  disputes        Dispute[]
  shippingAddress Address?      @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddress  Address?      @relation("BillingAddress", fields: [billingAddressId], references: [id])
  Payment         Payment[]

  @@index([buyerId])
  @@index([sellerId])
}

// Modèle Product
model Product {
  id           Int              @id @default(autoincrement())
  userId       Int
  name         String
  description  String
  price        Float
  brand        String?
  categoryId   Int?
  images       String[]
  condition    ProductCondition @default(GOOD)
  size         ProductSize?
  color        String?
  weight       Float?
  isNegotiable Boolean          @default(false)
  isReserved   Boolean          @default(false)
  isAvailable  Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Relations
  user     User       @relation(fields: [userId], references: [id])
  category Category?  @relation(fields: [categoryId], references: [id])
  reviews  Review[]
  wishlist Wishlist[]
  orders   Order[]    @relation("OrderProducts")
  events   Event[]
  disputes Dispute[]

  @@index([userId])
  @@index([categoryId])
}

// Modèle Transaction principal
model Transaction {
  id                    Int               @id @default(autoincrement())
  amount                Float
  type                  TransactionType
  status                TransactionStatus
  orderId               Int?
  sellerId              Int
  buyerId               Int
  commission            Float? // Commission de la plateforme
  stripePaymentIntentId String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  description           String?
  metadata              Json? // Pour stocker des informations supplémentaires
  currency              String            @default("EUR")

  // Relations
  order  Order? @relation(fields: [orderId], references: [id])
  seller User   @relation("SellerTransactions", fields: [sellerId], references: [id])
  buyer  User   @relation("BuyerTransactions", fields: [buyerId], references: [id])

  @@index([stripePaymentIntentId])
  @@index([orderId])
  @@index([sellerId])
  @@index([buyerId])
}

// Modèle pour les paiements (historique détaillé des tentatives de paiement)
model Payment {
  id            Int             @id @default(autoincrement())
  transactionId String? // ID de transaction externe (Stripe)
  orderId       Int
  amount        Float
  currency      String          @default("EUR")
  provider      PaymentProvider
  status        PaymentStatus
  errorMessage  String?
  metadata      Json? // Données supplémentaires spécifiques au provider
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([transactionId])
}

// Modèle pour les remboursements
model Refund {
  id            Int           @id @default(autoincrement())
  transactionId Int
  amount        Float
  reason        String
  status        PaymentStatus
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  processedAt   DateTime?
  requestedById Int
  approvedById  Int?

  // Relations
  requestedBy User  @relation("RefundRequester", fields: [requestedById], references: [id])
  approvedBy  User? @relation("RefundApprover", fields: [approvedById], references: [id])
  User        User? @relation(fields: [userId], references: [id])
  userId      Int?

  @@index([transactionId])
}

// Modèle pour les logs de paiement
model PaymentLog {
  id            Int      @id @default(autoincrement())
  transactionId String? // ID de transaction externe
  event         String // Type d'événement (payment.success, payment.failed, etc.)
  data          Json // Données complètes de l'événement
  createdAt     DateTime @default(now())

  @@index([transactionId])
}

// Modèle pour les frais et commissions
model Fee {
  id            Int      @id @default(autoincrement())
  transactionId Int
  type          String // PLATFORM_FEE, PAYMENT_PROCESSING, etc.
  amount        Float
  percentage    Float? // Si le frais est un pourcentage
  description   String?
  createdAt     DateTime @default(now())

  @@index([transactionId])
}

// Modèle pour la configuration des frais
model FeeConfiguration {
  id                  Int      @id @default(autoincrement())
  name                String   @unique // ex: "STANDARD_COMMISSION"
  defaultPercentage   Float
  minimumAmount       Float?
  maximumAmount       Float?
  isActive            Boolean  @default(true)
  applicableUserTypes String[] // ["PROFESSIONAL", "INDIVIDUAL"]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Modèle Address
model Address {
  id        Int     @id @default(autoincrement())
  userId    Int
  street    String
  city      String
  country   String
  zipCode   String
  isDefault Boolean @default(false)

  // Relations
  user           User    @relation(fields: [userId], references: [id])
  userAsDefault  User?   @relation("DefaultAddress")
  shippingOrders Order[] @relation("ShippingAddress")
  billingOrders  Order[] @relation("BillingAddress")

  @@index([userId])
}

// Modèle Post (Articles/Blog)
model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  authorId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  author User @relation(fields: [authorId], references: [id])

  @@index([authorId])
}

// Modèle Category
model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  slug        String  @unique @default("")
  description String?
  icon        String?
  parentId    Int?    @map("parent_id")

  // Relations
  parent                Category?              @relation("ParentChild", fields: [parentId], references: [id])
  children              Category[]             @relation("ParentChild")
  products              Product[]
  categorySubscriptions CategorySubscription[]

  @@index([parentId])
}

// Modèle Review
model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  userId    Int
  rating    Int // 1 à 5
  comment   String?
  createdAt DateTime @default(now())

  // Relations
  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
}

// Modèle Wishlist
model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id])
  products Product[]

  @@index([userId])
}

// Modèle Event
model Event {
  id          Int       @id @default(autoincrement())
  name        String
  description String
  startDate   DateTime
  endDate     DateTime
  products    Product[]
}

// Modèle UserFeedback
model UserFeedback {
  id        Int      @id @default(autoincrement())
  userId    Int
  content   String
  rating    Int
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Modèle CategorySubscription
model CategorySubscription {
  id         Int      @id @default(autoincrement())
  userId     Int
  categoryId Int
  createdAt  DateTime @default(now())

  // Relations
  user     User     @relation(fields: [userId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([categoryId])
}

// Modèle FavoriteSeller
model FavoriteSeller {
  id        Int      @id @default(autoincrement())
  userId    Int
  sellerId  Int
  createdAt DateTime @default(now())

  // Relations
  user   User @relation(name: "UserFavorites", fields: [userId], references: [id])
  seller User @relation(name: "SellerFavorites", fields: [sellerId], references: [id])

  @@index([userId])
  @@index([sellerId])
}

// Modèle Message
model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  content    String
  createdAt  DateTime @default(now())

  // Relations
  sender   User @relation("messageSender", fields: [senderId], references: [id])
  receiver User @relation("messageReceiver", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
}

// Modèle CommunicationPreference
model CommunicationPreference {
  id         Int     @id @default(autoincrement())
  userId     Int     @unique
  emailOptIn Boolean @default(true)

  // Relations
  user User @relation(fields: [userId], references: [id])
}

// Modèle EmailLog
model EmailLog {
  id      Int      @id @default(autoincrement())
  userId  Int?
  email   String
  subject String
  content String
  sentAt  DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Modèle Dispute
model Dispute {
  id          Int           @id @default(autoincrement())
  orderId     Int
  productId   Int
  buyerId     Int
  sellerId    Int
  reason      DisputeReason
  description String
  status      DisputeStatus @default(OPENED)
  resolution  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  buyer   User    @relation("BuyerDisputes", fields: [buyerId], references: [id])
  seller  User    @relation("SellerDisputes", fields: [sellerId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([buyerId])
  @@index([sellerId])
}

// Modèle Referral
model Referral {
  id            Int       @id @default(autoincrement())
  referrerId    Int
  referredId    Int
  status        String    @default("PENDING")
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  rewardClaimed Boolean   @default(false)

  // Relations
  referrer User @relation("UserReferrals", fields: [referrerId], references: [id])
  referred User @relation("ReferredUsers", fields: [referredId], references: [id])

  @@index([referrerId])
  @@index([referredId])
}
